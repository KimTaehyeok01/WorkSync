# docker-compose 실행 시 필요한 환경변수
# 이 파일을 복사해 .env로 만들고 실제 값을 채워서 사용하면 돼요. 소희와 아이들!

DB_URL=jdbc:postgresql://<host>:6543/postgres
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq API 키 (채팅 AI 요약). console.groq.com 에서 발급
GROQ_API_KEY=

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Matomo 서버 사이드 이벤트 (로그인·결재 상신). MATOMO_URL 이 비어 있으면 전송 비활성
MATOMO_URL=
MATOMO_SITE_ID=1
